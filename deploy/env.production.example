# Environment example for JobCat Frontend v2
# Copy to .env.production before building:  cp deploy/env.production.example .env.production
#
# NOTE: NEXT_PUBLIC_* variables are inlined into the JS bundle at BUILD time.
# After changing any value you MUST rebuild (npm run build) and restart the server.

# --- API ---------------------------------------------------------------
# Base URL of the Django API, including the /api suffix. No trailing slash.
NEXT_PUBLIC_API_URL=https://app.jobcat.in/api

# Legacy alias kept for backward compatibility with older code paths.
NEXT_PUBLIC_API_BASE_URL=https://app.jobcat.in

# --- Site / SEO ---------------------------------------------------------
# Public origin of this frontend. Used for metadataBase, canonical URLs,
# OpenGraph and sitemap.xml entries. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://jobcat.in

# --- Google Sign-In -----------------------------------------------------
# OAuth 2.0 Client ID (public value — safe to expose in the browser bundle).
# Must match the backend GOOGLE_CLIENT_ID and the authorized JavaScript
# origins configured in Google Cloud Console (https://jobcat.in).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Server runtime (used by systemd / next start) ----------------------
PORT=3000
HOSTNAME=127.0.0.1
NODE_ENV=production
